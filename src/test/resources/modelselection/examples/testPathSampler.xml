<run spec="modelselection.inference.PathSampler" nrOfSteps="4" chainLength="100000" alpha="0.3" rootdir="/tmp/step" burnInPercentage="80" preBurnin="50000" deleteOldLogs="true">
cd $(dir)
$(java) --module-path $(java.module.path) -m beast.pkgmgmt/beast.pkgmgmt.launcher.BeastLauncher $(resume/overwrite) -seed $(seed) beast.xml

  <mcmc chainLength="10000000" id="mcmc" spec="MCMC">
    <state id="state" storeEvery="1000">
        <tree id="Tree.t:alignment" name="stateNode">
            <taxonset id="TaxonSet.alignment" spec="TaxonSet">
                <data idref="alignment" name="alignment"/>
            </taxonset>
        </tree>
        <parameter id="birthRate.t:alignment" name="stateNode" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
        <parameter id="kappa.s:alignment" name="stateNode" value="2.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
        <parameter dimension="4" id="freqParameter.s:alignment" name="stateNode" value="0.25" spec="beast.base.spec.inference.parameter.SimplexParam"/>
    </state>

    <distribution id="posterior" spec="beast.base.inference.CompoundDistribution">
        <distribution id="prior" spec="beast.base.inference.CompoundDistribution">
            <distribution birthDiffRate="@birthRate.t:alignment" id="YuleModel.t:alignment" spec="beast.base.spec.evolution.speciation.YuleModel" tree="@Tree.t:alignment"/>
            <distribution id="Uniform.0" spec="beast.base.spec.inference.distribution.Uniform" param="@birthRate.t:alignment" upper="1.0E6"/>
            <distribution id="LogNormalDistributionModel.0" spec="beast.base.spec.inference.distribution.LogNormal" param="@kappa.s:alignment">
                    <parameter estimate="false" id="RealParameter.0" name="M" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
                    <parameter estimate="false" id="RealParameter.01" name="S" value="1.25" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
                </distribution>
        </distribution>
        <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution">
            <distribution data="@alignment" id="treeLikelihood.alignment" spec="beast.base.spec.evolution.likelihood.TreeLikelihood" tree="@Tree.t:alignment">
                <siteModel id="SiteModel.s:alignment" spec="beast.base.spec.evolution.sitemodel.SiteModel">
                    <parameter estimate="false" id="mutationRate.s:alignment" name="mutationRate" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
                    <parameter estimate="false" id="gammaShape.s:alignment" name="shape" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
                    <parameter estimate="false" id="proportionInvariant.s:alignment" name="proportionInvariant" value="0.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval"/>
                    <substModel id="hky.s:alignment" kappa="@kappa.s:alignment" spec="beast.base.spec.evolution.substitutionmodel.HKY">
                        <frequencies frequencies="@freqParameter.s:alignment" id="estimatedFreqs.s:alignment" spec="beast.base.spec.evolution.substitutionmodel.Frequencies"/>
                    </substModel>
                </siteModel>
                <branchRateModel id="StrictClock.c:alignment" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                    <parameter estimate="false" id="clockRate.c:alignment" name="clock.rate" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
                </branchRateModel>
            </distribution>
        </distribution>
    </distribution>

    <operator id="YuleBirthRateScaler.t:alignment" parameter="@birthRate.t:alignment" scaleFactor="0.75" weight="3.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="treeScaler.t:alignment" scaleFactor="0.5" tree="@Tree.t:alignment" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>

    <operator id="treeRootScaler.t:alignment" rootOnly="true" scaleFactor="0.5" tree="@Tree.t:alignment" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>

    <operator id="UniformOperator.t:alignment" tree="@Tree.t:alignment" weight="30.0" spec="beast.base.evolution.operator.Uniform"/>

<!--
    <operator id="SubtreeSlide.t:alignment" spec="SubtreeSlide" tree="@Tree.t:alignment" weight="15.0"/>
-->
    <operator id="narrow.t:alignment" spec="Exchange" tree="@Tree.t:alignment" weight="15.0"/>

    <operator id="wide.t:alignment" isNarrow="false" spec="Exchange" tree="@Tree.t:alignment" weight="3.0"/>

    <operator id="WilsonBalding.t:alignment" spec="WilsonBalding" tree="@Tree.t:alignment" weight="3.0"/>

    <operator id="KappaScaler.s:alignment" parameter="@kappa.s:alignment" scaleFactor="0.5" weight="0.1" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator delta="0.01" id="FrequenciesExchanger.s:alignment" spec="beast.base.spec.inference.operator.DeltaExchangeOperator" weight="0.1">
        <parameter idref="freqParameter.s:alignment"/>
    </operator>

    <logger fileName="alignment.$(seed).log" id="tracelog" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
        <log idref="posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
        <log idref="treeLikelihood.alignment"/>
        <log id="TreeHeight.t:alignment" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:alignment" logLength="false"/>
        <log idref="YuleModel.t:alignment"/>
        <parameter idref="birthRate.t:alignment" name="log"/>
        <parameter idref="kappa.s:alignment" name="log"/>
        <parameter idref="freqParameter.s:alignment" name="log"/>
    </logger>

    <logger id="screenlog" logEvery="1000">
        <log idref="posterior"/>
        <log arg="@posterior" id="ESS.0" spec="beast.base.spec.inference.util.ESS"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
    </logger>

    <logger fileName="$(tree).$(seed).trees" id="treelog.t:alignment" logEvery="1000" mode="tree">
        <log id="TreeWithMetaDataLogger.t:alignment" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@Tree.t:alignment"/>
    </logger>

    <init estimate="false" id="RandomTree.t:alignment" initial="@Tree.t:alignment" spec="beast.base.spec.evolution.tree.coalescent.RandomTree" taxa="@alignment">
        <populationModel id="ConstantPopulation0.t:alignment" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
            <parameter id="randomPopSize.t:alignment" name="popSize" value="1" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
        </populationModel>
    </init>
  </mcmc>
</run>

</beast>
