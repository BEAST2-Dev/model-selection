<beast version="2.8">
<!-- make sure you are running this in the project root dir -->
    <run spec='beast.inference.PairedPathSampler'
        rootdir='/tmp/step'
        model1='src/test/resources/modelselection/examples/normalTest-1.xml'
        model2='src/test/resources/modelselection/examples/normalTest-2.xml'
        nrOfSteps='32'
        alpha='3.0'
        chainLength='100000'
        burnInPercentage='50'
        preBurnin='100000'
        doNotRun='true'
		deleteOldLogs='true'
    >
cd $(dir)
$(java) --module-path $(java.module.path) -m beast.pkgmgmt/beast.pkgmgmt.launcher.BeastLauncher $(resume/overwrite) -java -seed $(seed) beast.xml

</run>
</beast>
